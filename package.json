{
  "name": "hermes-turn-router",
  "version": "0.4.0",
  "description": "A cache-aware, per-turn model router for Hermes Agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yueyue673/hermes-turn-router.git"
  },
  "homepage": "https://github.com/Yueyue673/hermes-turn-router#readme",
  "bugs": {
    "url": "https://github.com/Yueyue673/hermes-turn-router/issues"
  },
  "author": "Yueyue673 and contributors",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hermes-turn-router": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "presets",
    "integrations",
    "docs",
    "examples",
    "assets",
    "policy.schema.json"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json && npm run build:plugin",
    "build:plugin": "node scripts/build-hermes-plugin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli": "node scripts/smoke-cli.mjs",
    "test:plugin": "node scripts/smoke-plugin.mjs",
    "test:custom-policy": "node scripts/smoke-custom-policy.mjs",
    "test:integration": "python -m unittest discover -s integrations/hermes/tests -p test_*.py",
    "test:docs": "node scripts/verify-docs.mjs",
    "evaluate:reference": "npm run build && node scripts/generate-reference-evaluation.mjs",
    "test:evaluation": "node scripts/generate-reference-evaluation.mjs --check",
    "render:assets": "node scripts/render-assets.mjs",
    "render:demo": "npm run build && node scripts/render-demo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run test:integration && npm run build && npm run test:custom-policy && npm run test:plugin && npm run test:cli && npm run test:evaluation && npm run test:docs"
  },
  "keywords": [
    "hermes-agent",
    "llm",
    "model-routing",
    "llm-router",
    "cache-aware",
    "token-optimization"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
