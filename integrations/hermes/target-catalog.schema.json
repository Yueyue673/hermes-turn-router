{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Yueyue673/hermes-turn-router/main/integrations/hermes/target-catalog.schema.json",
  "title": "Hermes Turn Router target catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "max_cost_class": {
      "type": "string",
      "enum": ["free", "low", "standard", "premium"],
      "default": "standard"
    },
    "allow_cross_provider": {"type": "boolean", "default": true},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "model"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "label": {"type": "string", "maxLength": 128},
        "quality_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Explicit Gateway-authorized quality order used by Best once. Omit to disable Best once for this target."
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]{0,255}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]{0,255}$"
        },
        "reasoning_effort": {
          "type": "string",
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "cost_class": {
          "type": "string",
          "enum": ["free", "low", "standard", "premium"],
          "default": "standard"
        },
        "enabled": {"type": "boolean", "default": true},
        "requires_approval": {"type": "boolean", "default": false}
      }
    }
  }
}
