+        result["routing_intent"] = {
+            "target_id": intent.target_id,
+            "mode": intent.mode,
+            "reason_codes": list(intent.reason_codes),
+            **({"approval_token": intent.approval_token} if intent.approval_token else {}),
+        }
+    return result
+
+
+def _turn_router_raw(envelope: dict) -> dict:
+    raw: dict = {"clientTurnId": envelope["client_turn_id"]}
+    routing = envelope.get("routing_intent")
+    if routing:
+        raw["routingIntent"] = {
+            "targetId": routing["target_id"],
+            "mode": routing.get("mode") or "auto",
+            "reasonCodes": list(routing.get("reason_codes") or []),
+            **({"approvalToken": routing["approval_token"]} if routing.get("approval_token") else {}),
+        }
+    return raw
+
+
+def _turn_prompt_digest(session: dict, text: Any) -> str:
+    image_facts = []
+    for raw_path in session.get("attached_images", []):
+        try:
+            path = Path(str(raw_path))
+            stat = path.stat()
+            image_facts.append((path.name, stat.st_size, stat.st_mtime_ns))
+        except OSError:
+            image_facts.append((Path(str(raw_path)).name, None, None))
+    payload = json.dumps(
+        {"text": text if isinstance(text, str) else str(text), "images": image_facts},
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def _turn_router_runtime(session: dict):
+    from tui_gateway.turn_router.catalog import CatalogError
+    from tui_gateway.turn_router.runtime import runtime_for_home
+
+    home = _session_home(session)
+    try:
+        return runtime_for_home(home)
+    except (CatalogError, FileNotFoundError):
+        return None
+
+
+def _claim_client_turn(session: dict, envelope: dict | None, text: Any = "", sid: str = "") -> bool:
+    """Reserve one logical turn before the first accepted side effect."""
+    if not envelope:
+        return True
+    runtime = _turn_router_runtime(session)
+    if runtime is not None:
+        current_override = session.get("model_override") or {}
+        agent = session.get("agent")
+        current_provider = (
+            current_override.get("provider")
+            or getattr(agent, "provider_name", None)
+            or getattr(agent, "provider", None)
+        )
+        prepared = runtime.prepare(
+            _turn_router_raw(envelope),
+            session=session,
+            prompt_digest=_turn_prompt_digest(session, text),
+            current_provider=str(current_provider) if current_provider else None,
+            fallback_session_id=sid,
+        )
+        envelope["_ledger_outcome"] = prepared.ledger.outcome
+        envelope["_ledger_state"] = prepared.ledger.state
+        if prepared.ledger.outcome in ("duplicate", "in_progress"):
+            return False
+        if prepared.target is not None:
+            envelope["model_override"] = prepared.target.override_dict()
+        session.setdefault("_turn_router_prepared", {})[envelope["client_turn_id"]] = prepared
+        return True
+    if envelope.get("routing_intent"):
+        raise ValueError("Hermes Turn Router target catalog is not installed for this profile")
+
+    # Compatibility path for installations that have the generic turn id bridge
+    # but have not installed a Router catalog yet.
+    turn_id = envelope["client_turn_id"]
+    with _claimed_turn_ids_lock:
+        if turn_id in _claimed_turn_ids:
+            return False
+        _claimed_turn_ids.add(turn_id)
+        _claimed_turn_id_order.append(turn_id)
+        if len(_claimed_turn_id_order) > 4096:
+            retired = _claimed_turn_id_order.pop(0)
+            _claimed_turn_ids.discard(retired)
+        return True
+
+
+def _accept_client_turn(session: dict, envelope: dict | None, sid: str = "") -> None:
+    if not envelope:
+        return
+    prepared = (session.get("_turn_router_prepared") or {}).get(envelope.get("client_turn_id"))
+    runtime = _turn_router_runtime(session)
+    if prepared is not None and runtime is not None:
+        if not runtime.accept(prepared, session=session, fallback_session_id=sid):
+            raise ValueError("Hermes Turn Router reservation lease was lost before acceptance")
+
+
+def _complete_client_turn(session: dict, envelope: dict | None, sid: str = "") -> None:
+    if not envelope:
+        return
+    prepared = (session.get("_turn_router_prepared") or {}).pop(envelope.get("client_turn_id"), None)
+    runtime = _turn_router_runtime(session)
+    if prepared is not None and runtime is not None:
+        if not runtime.complete(prepared, session=session, fallback_session_id=sid):
+            raise ValueError("Hermes Turn Router reservation lease was lost before completion")
+
+
+def _release_client_turn(session: dict, envelope: dict | None, sid: str = "") -> None:
+    """Release a reserved turn id when submit fails before acceptance."""
+    if not envelope:
+        return
+    turn_id = envelope.get("client_turn_id")
+    prepared = (session.get("_turn_router_prepared") or {}).pop(turn_id, None)
+    runtime = _turn_router_runtime(session)
+    if prepared is not None and runtime is not None:
+        runtime.release(prepared, session=session, fallback_session_id=sid)
+        envelope.pop("model_override", None)
+        return
+    if not turn_id:
+        return
+    with _claimed_turn_ids_lock:
+        _claimed_turn_ids.discard(turn_id)
+        try:
+            _claimed_turn_id_order.remove(turn_id)
+        except ValueError:
+            pass
+
