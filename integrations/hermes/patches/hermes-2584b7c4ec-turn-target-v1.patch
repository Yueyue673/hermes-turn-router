diff --git a/tests/tui_gateway/test_turn_router_mature.py b/tests/tui_gateway/test_turn_router_mature.py
new file mode 100644
index 0000000000..bdf246a54b
--- /dev/null
+++ b/tests/tui_gateway/test_turn_router_mature.py
@@ -0,0 +1,157 @@
+import json
+from pathlib import Path
+
+import pytest
+
+from tui_gateway import server
+
+
+def write_catalog(home: Path):
+    directory = home / "turn-router"
+    directory.mkdir(parents=True, exist_ok=True)
+    (directory / "targets.json").write_text(json.dumps({
+        "schema_version": 1,
+        "max_cost_class": "premium",
+        "allow_cross_provider": False,
+        "targets": [
+            {"id": "fast", "label": "Fast", "provider": "p", "model": "m1", "cost_class": "low"},
+            {"id": "premium", "label": "Premium", "provider": "p", "model": "m2", "reasoning_effort": "high", "cost_class": "premium"},
+        ],
+    }), encoding="utf-8")
+
+
+def session(home: Path):
+    return {
+        "agent": None,
+        "attached_images": [],
+        "history_lock": __import__("threading").Lock(),
+        "model_override": {"provider": "p", "model": "baseline"},
+        "profile_home": str(home),
+        "session_key": "lineage-root",
+    }
+
+
+def test_turn_intent_rejects_client_model_strings_and_accepts_target_id():
+    with pytest.raises(ValueError, match="client model overrides"):
+        server._normalize_turn_envelope({
+            "clientTurnId": "turn-1",
+            "modelOverride": {"provider": "evil", "model": "expensive"},
+        })
+    normalized = server._normalize_turn_envelope({
+        "clientTurnId": "turn-1",
+        "routingIntent": {"targetId": "fast", "mode": "auto", "reasonCodes": ["simple"]},
+    })
+    assert normalized == {
+        "client_turn_id": "turn-1",
+        "routing_intent": {"target_id": "fast", "mode": "auto", "reason_codes": ["simple"]},
+    }
+
+
+def test_gateway_resolves_target_and_persists_accept_complete(tmp_path):
+    write_catalog(tmp_path)
+    live = session(tmp_path)
+    envelope = server._normalize_turn_envelope({
+        "clientTurnId": "turn-accepted",
+        "routingIntent": {"targetId": "premium", "mode": "quality", "reasonCodes": ["quality_mode"]},
+    })
+    assert server._claim_client_turn(live, envelope, "hello", "ui-1") is True
+    assert envelope["model_override"] == {"target_id": "premium", "provider": "p", "model": "m2", "reasoning_effort": "high"}
+    server._accept_client_turn(live, envelope, "ui-1")
+    row = server._turn_router_runtime(live).ledger.get(
+        profile=server._turn_router_runtime(live).profile_scope,
+        lineage="lineage-root",
+        turn_id="turn-accepted",
+    )
+    assert row["state"] == "accepted"
+    server._complete_client_turn(live, envelope, "ui-1")
+    row = server._turn_router_runtime(live).ledger.get(
+        profile=server._turn_router_runtime(live).profile_scope,
+        lineage="lineage-root",
+        turn_id="turn-accepted",
+    )
+    assert row["state"] == "completed"
+
+
+def test_accepted_turn_is_duplicate_after_new_runtime_session(tmp_path):
+    write_catalog(tmp_path)
+    first = session(tmp_path)
+    envelope = server._normalize_turn_envelope({"clientTurnId": "turn-retry"})
+    assert server._claim_client_turn(first, envelope, "hello", "ui-1") is True
+    server._accept_client_turn(first, envelope, "ui-1")
+    resumed = session(tmp_path)
+    retry = server._normalize_turn_envelope({"clientTurnId": "turn-retry"})
+    assert server._claim_client_turn(resumed, retry, "hello", "ui-2") is False
+
+
+def test_pre_accept_release_allows_retry(tmp_path):
+    write_catalog(tmp_path)
+    live = session(tmp_path)
+    envelope = server._normalize_turn_envelope({"clientTurnId": "turn-release"})
+    assert server._claim_client_turn(live, envelope, "hello", "ui-1") is True
+    server._release_client_turn(live, envelope, "ui-1")
+    retry = server._normalize_turn_envelope({"clientTurnId": "turn-release"})
+    assert server._claim_client_turn(live, retry, "hello", "ui-1") is True
+
+
+def test_in_progress_and_accepted_duplicates_are_distinct(tmp_path):
+    write_catalog(tmp_path)
+    first_session = session(tmp_path)
+    first = server._normalize_turn_envelope({"clientTurnId": "turn-state"})
+    assert server._claim_client_turn(first_session, first, "hello", "ui-1") is True
+    concurrent = server._normalize_turn_envelope({"clientTurnId": "turn-state"})
+    assert server._claim_client_turn(session(tmp_path), concurrent, "hello", "ui-2") is False
+    assert concurrent["_ledger_outcome"] == "in_progress"
+    assert concurrent["_ledger_state"] == "reserved"
+    server._accept_client_turn(first_session, first, "ui-1")
+    accepted_retry = server._normalize_turn_envelope({"clientTurnId": "turn-state"})
+    assert server._claim_client_turn(session(tmp_path), accepted_retry, "hello", "ui-3") is False
+    assert accepted_retry["_ledger_outcome"] == "duplicate"
+    assert accepted_retry["_ledger_state"] == "accepted"
+
+
+def test_router_capability_method_is_registered():
+    assert "router.capabilities" in server._methods
+
+
+class FakeAgent:
+    def __init__(self, effort="high"):
+        self.model = "gpt-5.6-sol"
+        self.provider = "openai-codex"
+        self.reasoning_config = {"enabled": True, "effort": effort}
+        self.api_key = ""
+        self.base_url = "https://example.invalid"
+        self.api_mode = ""
+        self._primary_runtime = None
+        self.switches = 0
+
+    def switch_model(self, **_kwargs):
+        self.switches += 1
+
+
+def test_exact_active_turn_target_does_not_rebuild_client(monkeypatch):
+    agent = FakeAgent("high")
+    monkeypatch.setattr(server, "_emit", lambda *_args, **_kwargs: None)
+    restore = server._apply_turn_model_override("ui", {"agent": agent}, {
+        "target_id": "strong",
+        "provider": "openai-codex",
+        "model": "gpt-5.6-sol",
+        "reasoning_effort": "high",
+    })
+    assert restore is None
+    assert agent.switches == 0
+
+
+def test_effort_only_turn_target_avoids_model_switch_and_restores(monkeypatch):
+    agent = FakeAgent("high")
+    monkeypatch.setattr(server, "_emit", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_session_info", lambda *_args, **_kwargs: {})
+    restore = server._apply_turn_model_override("ui", {"agent": agent}, {
+        "target_id": "premium",
+        "provider": "openai-codex",
+        "model": "gpt-5.6-sol",
+        "reasoning_effort": "xhigh",
+    })
+    assert agent.switches == 0
+    assert agent.reasoning_config["effort"] == "xhigh"
+    server._restore_agent_model_runtime(agent, restore)
+    assert agent.reasoning_config["effort"] == "high"
