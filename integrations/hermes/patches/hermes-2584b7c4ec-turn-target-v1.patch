diff --git a/apps/desktop/src/lib/turn-execution.ts b/apps/desktop/src/lib/turn-execution.ts
new file mode 100644
index 0000000000..141398eb32
--- /dev/null
+++ b/apps/desktop/src/lib/turn-execution.ts
@@ -0,0 +1,43 @@
+/** Immutable, client-owned identity plus an optional server-resolved target intent. */
+export interface TurnRoutingIntent {
+  targetId: string
+  mode: string
+  reasonCodes: string[]
+  approvalToken?: string
+}
+
+export interface TurnExecutionEnvelope {
+  clientTurnId: string
+  routingIntent?: TurnRoutingIntent
+}
+
+type TurnAcceptedListener = (clientTurnId: string) => void
+const acceptedListeners = new Set<TurnAcceptedListener>()
+
+export function onTurnAccepted(listener: TurnAcceptedListener): () => void {
+  acceptedListeners.add(listener)
+  return () => acceptedListeners.delete(listener)
+}
+
+export function notifyTurnAccepted(clientTurnId: string): void {
+  for (const listener of acceptedListeners) listener(clientTurnId)
+}
+
+export function notifyAcceptedTurnFromResponse(
+  envelope: TurnExecutionEnvelope | undefined,
+  response: unknown
+): boolean {
+  if (!envelope || !response || typeof response !== 'object' || (response as { accepted?: boolean }).accepted !== true) {
+    return false
+  }
+  notifyTurnAccepted(envelope.clientTurnId)
+  return true
+}
+
+export function createClientTurnId(): string {
+  if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
+    return crypto.randomUUID()
+  }
+
+  return `turn-${Date.now()}-${Math.random().toString(36).slice(2, 12)}`
+}
diff --git a/apps/desktop/src/sdk/composer-routing.test.ts b/apps/desktop/src/sdk/composer-routing.test.ts
new file mode 100644
index 0000000000..17e43d936b
--- /dev/null
+++ b/apps/desktop/src/sdk/composer-routing.test.ts
@@ -0,0 +1,60 @@
+import { beforeEach, describe, expect, it } from 'vitest'
+
+import {
+  createClientTurnId,
+  notifyAcceptedTurnFromResponse,
+  notifyTurnAccepted,
+  onTurnAccepted,
+  type TurnExecutionEnvelope
+} from '@/lib/turn-execution'
+import { $queuedPromptsBySession, enqueueQueuedPrompt, getQueuedPrompts, updateQueuedPromptText } from '@/store/composer-queue'
+
+const SESSION = 'turn-envelope-test'
+
+function envelope(id = 'turn-1'): TurnExecutionEnvelope {
+  return {
+    clientTurnId: id,
+    routingIntent: { mode: 'quality', reasonCodes: ['explicit_quality'], targetId: 'premium' }
+  }
+}
+
+describe('turn execution envelopes', () => {
+  beforeEach(() => {
+    window.localStorage.clear()
+    $queuedPromptsBySession.set({})
+  })
+
+  it('mints stable wire-safe ids', () => {
+    const first = createClientTurnId()
+    const second = createClientTurnId()
+
+    expect(first).toMatch(/^[A-Za-z0-9._:-]+$/)
+    expect(second).not.toBe(first)
+  })
+
+  it('clones a route snapshot into a queued turn', () => {
+    const original = envelope()
+    enqueueQueuedPrompt(SESSION, { attachments: [], text: 'important', turnEnvelope: original })
+    original.routingIntent!.targetId = 'tampered-after-enqueue'
+
+    expect(getQueuedPrompts(SESSION)[0]?.turnEnvelope).toEqual(envelope())
+  })
+
+  it('invalidates the snapshot when queued text is edited', () => {
+    enqueueQueuedPrompt(SESSION, { attachments: [], text: 'before', turnEnvelope: envelope() })
+    const entry = getQueuedPrompts(SESSION)[0]!
+
+    expect(updateQueuedPromptText(SESSION, entry.id, 'after')).toBe(true)
+    expect(getQueuedPrompts(SESSION)[0]?.turnEnvelope).toBeUndefined()
+  })
+
+  it('notifies one-shot state only after the gateway accepts a turn', () => {
+    const accepted: string[] = []
+    const dispose = onTurnAccepted(id => accepted.push(id))
+    expect(notifyAcceptedTurnFromResponse(envelope('turn-in-progress'), { accepted: false })).toBe(false)
+    expect(notifyAcceptedTurnFromResponse(envelope('turn-accepted'), { accepted: true })).toBe(true)
+    dispose()
